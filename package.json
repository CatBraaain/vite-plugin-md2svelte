{
  "name": "vite-plugin-md2svelte",
  "version": "0.0.2",
  "description": "A Vite plugin that converts Markdown files to Svelte components with frontmatter support, custom components, and plugin extensibility",
  "keywords": [
    "frontmatter",
    "markdown",
    "md",
    "rehype",
    "remark",
    "svelte",
    "vite",
    "vite-plugin"
  ],
  "license": "MIT",
  "author": "CatBraaain",
  "repository": {
    "type": "git",
    "url": "https://github.com/CatBraaain/vite-plugin-md2svelte.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "ci": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "devalue": "^5.8.0",
    "gray-matter": "^4.0.3",
    "rehype-raw": "^7.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "stringify-entities": "^4.0.4",
    "unified": "^11.0.5",
    "unist": "^0.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/hast": "^3.0.4",
    "svelte": "^5.55.5",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "bun@1.3.13"
}
